{
  "name": "ontorale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:integration": "pnpm --filter @ontorale/server test:integration",
    "test:e2e:install": "pnpm --filter @ontorale/e2e exec playwright install --with-deps chromium",
    "test:e2e": "pnpm --filter @ontorale/e2e test",
    "build": "pnpm -r --filter=!@ontorale/e2e build",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
